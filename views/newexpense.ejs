<%- include("partials/header.ejs") %>
    <% if (error) { %>
        <p class="error">
            <%= error %>
        </p>
        <% } %>
            <form action="/expenses/new" method="post">
                <label for="amount">Amount (EGP):</label>
                <input type="number" min="0.01" id="amount" name="amount" step="0.01" required
                    onkeydown="if(['-', '+', 'e', 'E'].includes(event.key)) event.preventDefault();"
                    value="<%= values.amount %>">
                <label for="category">Choose a category</label>
                <select name="category" id="category" required>
                    <% categories.forEach(category=> { %>
                        <option value="<%= category %>" <%=values.category===category ? "selected" : "" %>>
                            <%= category %>
                        </option>
                        <% }); %>
                </select>
                <label for="description">Expense description:</label>
                <input type="text" id="description" name="description" maxlength="120"
                    value="<%= values.description %>">
                <label for="date">Date:</label>
                <input type="date" id="date" name="date" required value="<%= values.date %>">
                <button type="submit">Add Expense</button>
            </form>